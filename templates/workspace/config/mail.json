{
  "_comment": "Read-only inbox scan. adapter: gws (the bundled Google Workspace CLI), bridge (the agent fetches with a mail connector through request/response files in data/mail/, see scripts/mail-scan.mjs), or none. Headers are read first; a body opens only on a hunt signal; never_open beats every signal. first_scan_after (ISO date) is where the first scan starts.",
  "adapter": "none",
  "gws": {
    "bin": ""
  },
  "bridge": {
    "wait_seconds": 180,
    "max_list": 500,
    "_why": "wait_seconds: how long a bridge fetch request polls for the agent's response when the caller names no wait. The apply runner's code waits (security code, one-time password, verify link) always use config/apply.json code_wait_seconds. max_list: the most headers one scan asks the agent to list."
  },
  "me": "",
  "first_scan_after": null,
  "query": "(in:inbox OR category:promotions)",
  "max_per_run": 200,
